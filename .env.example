# Select which roles use Pi RPC. Unset or use "mock" for deterministic mocks.
DRAFTING_ENGINE=pi
CRITIC_ENGINE=pi

# Generic Pi defaults shared by every Pi-backed role.
PI_PROVIDER=anthropic
# PI_MODEL=choose-a-model-from-pi-list-models
# PI_THINKING=medium

# Pi inherits standard provider credentials from the environment.
# Never commit a real key here.
# ANTHROPIC_API_KEY=replace-locally

# Optional role-specific overrides.
# PI_DRAFTING_PROVIDER=anthropic
# PI_DRAFTING_MODEL=...
# PI_DRAFTING_THINKING=medium
# PI_CRITIC_PROVIDER=anthropic
# PI_CRITIC_MODEL=...
# PI_CRITIC_THINKING=high

PORT=4100
RUNNER_PORT=4101
