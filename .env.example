# Select which roles use Pi RPC. Unset or use "mock" for deterministic mocks.
DRAFTING_ENGINE=pi
CRITIC_ENGINE=pi
# Unset or use "mock" to format without posting to Slack.
# SEND_ENGINE=composio-slack

# Generic Pi defaults shared by every Pi-backed role.
PI_PROVIDER=anthropic
# PI_MODEL=choose-a-model-from-pi-list-models
# PI_THINKING=medium

# Pi inherits standard provider credentials from the environment.
# Never commit a real key here.
# ANTHROPIC_API_KEY=replace-locally

# Optional role-specific overrides.
# PI_RESEARCH_PROVIDER=anthropic
# PI_RESEARCH_MODEL=...
# PI_RESEARCH_THINKING=medium
# PI_DRAFTING_PROVIDER=anthropic
# PI_DRAFTING_MODEL=...
# PI_DRAFTING_THINKING=medium
# PI_CRITIC_PROVIDER=anthropic
# PI_CRITIC_MODEL=...
# PI_CRITIC_THINKING=high

PORT=4100
RUNNER_PORT=4101

# Distributed deployment. Each remote runner uses one role:
# research, drafting, critic (also review/deep_review), or send.
# RUNNER_ROLE=research
# HOST=0.0.0.0
# PORT=8000
# RUNNER_AUTH_TOKEN_FILE=/home/exedev/.factory-secrets/runner-token

# The remote orchestrator connects to all four role runners over authenticated
# WebSockets and protects workflow APIs with a separate bearer token.
# RUNNER_RESEARCH_URL=wss://factory-research.exe.xyz/ws
# RUNNER_DRAFTING_URL=wss://factory-drafting.exe.xyz/ws
# RUNNER_CRITIC_URL=wss://factory-critic.exe.xyz/ws
# RUNNER_SEND_URL=wss://factory-send.exe.xyz/ws
# ORCHESTRATOR_API_TOKEN_FILE=/home/exedev/.factory-secrets/api-token
# MAX_DRAFT_ATTEMPTS=3

# Internal research through Composio. Keep the real key only in .env or the
# process environment; .env is ignored by Git.
RESEARCH_ENGINE=pi-composio
# COMPOSIO_API_KEY=replace-locally
# Must exactly match the User ID attached to the connected accounts.
COMPOSIO_USER_ID=replace-with-connected-account-user-id
COMPOSIO_RESEARCH_TIMEOUT_MS=30000

# Agentic research limits. The Pi session chooses the next read-only operation,
# while TypeScript enforces these hard budgets and the tool allowlist.
PI_RESEARCH_MAX_TOOL_CALLS=8
PI_RESEARCH_TOTAL_TIMEOUT_MS=240000

# Optional but recommended when a user has multiple accounts for one toolkit.
# These are connected-account IDs (ca_*), not auth-config IDs (ac_*).
# COMPOSIO_SLACK_CONNECTED_ACCOUNT_ID=ca_replace-locally
# COMPOSIO_GRANOLA_CONNECTED_ACCOUNT_ID=ca_replace-locally
# COMPOSIO_FIREFLIES_CONNECTED_ACCOUNT_ID=ca_replace-locally
# COMPOSIO_SALESFORCE_CONNECTED_ACCOUNT_ID=ca_replace-locally
# COMPOSIO_POSTHOG_CONNECTED_ACCOUNT_ID=ca_replace-locally
# COMPOSIO_METABASE_CONNECTED_ACCOUNT_ID=ca_replace-locally

# PostHog requires the project containing the people to search.
# COMPOSIO_POSTHOG_PROJECT_ID=12345

# Metabase uses a preconfigured read-only saved card. By default, the card is
# expected to expose template tags named "person" and "company".
# COMPOSIO_METABASE_CARD_ID=77
COMPOSIO_METABASE_PERSON_TAG=person
COMPOSIO_METABASE_COMPANY_TAG=company

# Slack send agent. A real send requires SEND_ENGINE=composio-slack and the
# Slack connected-account ID above. An exact user ID is safest. If omitted,
# the agent searches the query and sends only when exactly one user matches.
COMPOSIO_SLACK_RECIPIENT_QUERY=archit
# COMPOSIO_SLACK_RECIPIENT_USER_ID=U0123456789
COMPOSIO_SLACK_SEND_TIMEOUT_MS=30000
