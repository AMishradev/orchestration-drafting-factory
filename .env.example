# Select which roles use Pi RPC. Unset or use "mock" for deterministic mocks.
DRAFTING_ENGINE=pi
CRITIC_ENGINE=pi

# Generic Pi defaults shared by every Pi-backed role.
PI_PROVIDER=anthropic
# PI_MODEL=choose-a-model-from-pi-list-models
# PI_THINKING=medium

# Pi inherits standard provider credentials from the environment.
# Never commit a real key here.
# ANTHROPIC_API_KEY=replace-locally

# Optional role-specific overrides.
# PI_DRAFTING_PROVIDER=anthropic
# PI_DRAFTING_MODEL=...
# PI_DRAFTING_THINKING=medium
# PI_CRITIC_PROVIDER=anthropic
# PI_CRITIC_MODEL=...
# PI_CRITIC_THINKING=high

PORT=4100
RUNNER_PORT=4101

# Internal research through Composio. Keep the real key only in .env or the
# process environment; .env is ignored by Git.
RESEARCH_ENGINE=composio
# COMPOSIO_API_KEY=replace-locally
COMPOSIO_USER_ID=default
COMPOSIO_RESEARCH_TIMEOUT_MS=30000

# PostHog requires the project containing the people to search.
# COMPOSIO_POSTHOG_PROJECT_ID=12345

# Metabase uses a preconfigured read-only saved card. By default, the card is
# expected to expose template tags named "person" and "company".
# COMPOSIO_METABASE_CARD_ID=77
COMPOSIO_METABASE_PERSON_TAG=person
COMPOSIO_METABASE_COMPANY_TAG=company
